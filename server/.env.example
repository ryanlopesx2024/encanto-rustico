# Copie para .env em ambiente local (nunca commitar o .env de verdade).
# Em produção (Render), configure essas variáveis em Settings → Environment.

# Login do Meu Correios (idcorreios.correios.com.br) — API pública de Preço/Prazo,
# não precisa de contrato nem cartão de postagem.
CORREIOS_USER=
CORREIOS_PASS=

# CEP de origem da loja (Av. Dr. Nóide Cerqueira, 7117 — Feira de Santana/BA)
CORREIOS_CEP_ORIGEM=44079390

# Use 1 para testar no ambiente de homologação dos Correios antes de ir para produção
CORREIOS_HOMOLOG=0
